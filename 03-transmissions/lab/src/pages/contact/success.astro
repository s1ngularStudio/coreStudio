---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="(. )° Studio — Thank You">
  <h1 style="font-family: var(--font-display); font-size: 48px; letter-spacing: 0.02em; margin: 0 0 16px;">
    THANK YOU!
  </h1>
  <p style="font-family: var(--font-body); font-size: 17px; line-height: 1.7; max-width: 560px; margin: 0 0 24px;">
    Your message is in. I'll get back to you soon.
  </p>
  <a href="/work" class="label" style="font-size: 11px; color: var(--ink);">&larr; Back to Work</a>
</BaseLayout>
