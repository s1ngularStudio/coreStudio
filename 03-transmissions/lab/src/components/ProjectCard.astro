---
interface Props {
  href: string;
  image?: string;
  title: string;
  description: string;
  tags: readonly string[];
}

const { href, image, title, description, tags } = Astro.props;

const VIDEO_EXTENSIONS = [".mp4", ".webm", ".mov"];
const isVideo = image ? VIDEO_EXTENSIONS.some((ext) => image.toLowerCase().endsWith(ext)) : false;
---

<div style="grid-column: span 4;">
  <a href={href} style="display: block;">
    <div style="aspect-ratio: 4 / 3; width: 100%; background: var(--hair); margin-bottom: 12px;">
      {image && (
        isVideo ? (
          <video src={image} autoplay loop muted playsinline style="width: 100%; height: 100%; object-fit: cover; display: block;" />
        ) : (
          <img src={image} alt="" style="width: 100%; height: 100%; object-fit: cover; display: block;" />
        )
      )}
    </div>
  </a>
  <a href={href} style="color: var(--ink); text-decoration: none;">
    <h3 style="font-family: var(--font-heading); text-transform: uppercase; letter-spacing: 2px; font-size: 16px; margin: 0 0 6px;">
      {title}
    </h3>
  </a>
  <p style="font-family: var(--font-body); font-size: 14px; line-height: 1.5; color: var(--ink-soft); margin: 0 0 10px;">
    {description}
  </p>
  <div style="display: flex; gap: 8px; flex-wrap: wrap;">
    {
      tags.map((tag) => (
        <span
          class="label"
          style="font-size: 9px; color: var(--ink-soft); background: var(--hair); padding: 4px 10px; border-radius: 999px;"
        >
          {tag}
        </span>
      ))
    }
  </div>
</div>
