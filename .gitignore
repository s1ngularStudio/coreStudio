.LSOverride
._*

# === Processing ===
# Keep sketch folders but ignore output
*.mov
*.avi
application.*/
!03-transmissions/web-assets/**/*.mov

# Video is ignored by default (Processing sketch output) except in web-assets,
# where MP4s are the actual deliverable (Framer hero/carousel video).
*.mp4
!03-transmissions/web-assets/**/*.mp4

# === IDE ===
.vscode/
.idea/
*.swp
*.swo
*~

# === Logs ===
*.log
logs/

# chess_music_sync's raw session captures (track/move logs) -- personal play data,
# not source. Scoped to this project's own data/ dir, not a blanket "data/" pattern,
# since other subprojects in this repo may have their own unrelated data/ folders.
02-digital/explorations/chess_music_sync/data/

# === Temporary files ===
tmp/
temp/
*.tmp

# Runtime IPC files the chat bot writes to control the snowglobe sketch -- not deliverables
03-transmissions/stream-assets/snowglobe/snow_state.txt
03-transmissions/stream-assets/snowglobe/polar_bear_state.txt
